{
  "name": "lighthouse-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "main": "dist/main.js",
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "build": {
    "appId": "com.lighthouse.labassistant",
    "productName": "Lighthouse",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "version": "0.1.0",
  "description": "Lighthouse guide cursor for computer labs",
  "author": "Lighthouse Team"
}