{
  "name": "lighthouse-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "main": "dist/main.js",
  "dependencies": {
    "mqtt": "^5.10.1",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.lighthouse.labassistant",
    "productName": "Lighthouse",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/LighthouseBridge.exe",
        "to": "native/LighthouseBridge.exe"
      }
    ],
    "win": {
      "icon": "native/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "native/icon.ico",
      "uninstallerIcon": "native/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lighthouse"
    },
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "lighthouse",
        "name": "Lighthouse.Recording",
        "description": "Lighthouse Recording",
        "icon": "native/icon.ico",
        "role": "Editor"
      }
    ]
  },
  "version": "0.3.5",
  "description": "Lighthouse guide cursor for computer labs",
  "author": "Lighthouse Team"
}
