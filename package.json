{
  "name": "lighthouse-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "LIGHTHOUSE_MAC_ARCH=universal npm run build && electron-builder --mac dmg zip --universal --publish never",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "main": "dist/main.js",
  "dependencies": {
    "mqtt": "^5.10.1",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.lighthouse.labassistant",
    "productName": "Lighthouse",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "native/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "native/bin/LighthouseBridge.exe",
          "to": "native/LighthouseBridge.exe"
        }
      ],
      "fileAssociations": [
        {
          "ext": "lighthouse",
          "name": "Lighthouse.Recording",
          "description": "Lighthouse Recording",
          "icon": "native/icon.ico",
          "role": "Editor"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "x64ArchFiles": "Contents/Resources/native/LighthouseBridge",
      "extraResources": [
        {
          "from": "native/bin/LighthouseBridge",
          "to": "native/LighthouseBridge"
        }
      ],
      "fileAssociations": [
        {
          "ext": "lighthouse",
          "name": "Lighthouse.Recording",
          "description": "Lighthouse Recording",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "native/icon.ico",
      "uninstallerIcon": "native/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lighthouse"
    },
    "directories": {
      "output": "release"
  }
  },
  "version": "0.3.3",
  "description": "Lighthouse guide cursor for computer labs",
  "author": "Lighthouse Team"
}
