{
  "name": "lighthouse-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "electron-builder": "^25.1.8"
  },
  "main": "dist/main.js",
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "build": {
    "appId": "com.lighthouse.labassistant",
    "productName": "Lighthouse",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/overlay.html",
        "to": "overlay.html"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "version": "0.1.0",
  "description": "Lighthouse guide cursor for computer labs",
  "author": "Lighthouse Team"
}
